# ============================================================
# AETHER — Frontend Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values below.
#
#   cp .env.example .env.local
#
# .env.local is gitignored so your keys are never committed.
# ============================================================


# ── Supabase ─────────────────────────────────────────────────
# Get these from: Supabase dashboard → Settings → API
#
# The URL is your project's REST endpoint.
# The anon key is the public "anon / public" key — safe to use
# in the browser as long as Row-Level Security is enabled.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key


# ── Backend API ───────────────────────────────────────────────
# URL of the FastAPI backend (see /backend).
# Change this if you're running the backend on a different port
# or deploying it remotely.

NEXT_PUBLIC_API_URL=http://localhost:8000
